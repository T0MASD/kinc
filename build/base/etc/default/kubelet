# Read by kubeadm's kubelet unit as EnvironmentFile=-/etc/default/kubelet.
#
# KubeletInUserNamespace is what lets the kubelet run without real root: it
# stops it trying to manage cgroups, sysctls and oom scores it cannot touch
# from inside a user namespace.
#
# It is also declared in kubeadm.conf's KubeletConfiguration, which is the
# canonical place and what lands in /var/lib/kubelet/config.yaml. This is kept
# as a flag because it has to hold for the kubelet's very first start, before
# kubeadm has written that file - kubelet-start runs after the kubelet is
# already up.
KUBELET_EXTRA_ARGS="--feature-gates=KubeletInUserNamespace=true"
