[Unit]
Description=kubeadm Kubernetes Cluster Initialization
Documentation=https://kubernetes.io/docs/reference/setup-tools/kubeadm/
After=kinc-preflight.service
Requires=kinc-preflight.service
ConditionPathExists=!/var/lib/kubeadm-initialized
ConditionPathExists=/tmp/kubeadm-final.conf

[Service]
Type=oneshot
# The log directory lives on a mount that may be empty on first boot.
ExecStartPre=/usr/bin/mkdir -p /var/log/kinc
RemainAfterExit=yes
TimeoutStartSec=300
Restart=no

# Run kubeadm init
ExecStart=/usr/bin/kubeadm init --config=/tmp/kubeadm-final.conf --skip-phases=preflight,upload-config/kubelet,show-join-command

# Create success marker
ExecStartPost=/bin/touch /var/lib/kubeadm-initialized

# To a file under /var/log, which deployments publish to the hypervisor, and to
# the journal. kubeadm's own output is the account of why a cluster did or did
# not initialise, and the journal alone is volatile: it goes with the container.
StandardOutput=append:/var/log/kinc/kubeadm-init.log
StandardError=append:/var/log/kinc/kubeadm-init.log

[Install]
WantedBy=multi-user.target

