[Unit]
Description=kinc Pre-flight Checks and Configuration
Documentation=https://github.com/T0MASD/kinc
After=crio.service kubelet.service
Requires=crio.service
Wants=kubelet.service
ConditionPathExists=!/var/lib/kubeadm-initialized

[Service]
Type=oneshot
RemainAfterExit=yes
# Sized for the image pre-pull, which is the slow thing this unit does.
#
# 120s was sized for a warm image store, where the crictl check finds every
# control-plane image present and the pull is skipped entirely - so the timeout
# never bit in CI or on a machine that had run kinc before. A cold store has to
# fetch roughly half a gigabyte before kubeadm can start, and every machine
# joining a multi-host cluster is cold by definition. Exceeding it kills
# preflight mid-pull, and kubeadm-init and kinc-postinit then fail as
# dependencies, which reads as a broken cluster rather than a slow download.
TimeoutStartSec=15min
Restart=no

# Pass environment variables from container to service.
#
# An allowlist, not a pass-through: systemd gives a service a clean environment,
# so a variable set on the container reaches PID 1 and stops there unless it is
# named here. A variable missing from this line is silently empty in the script.
PassEnvironment=KINC_ENABLE_FARO KINC_AUDIT_RESOURCES KINC_NODE_MEMORY KINC_NODE_CPUS

# Run preflight checks and setup
ExecStart=/etc/kinc/scripts/kinc-preflight.sh

# Ensure output goes to journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

