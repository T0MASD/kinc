[Unit]
Description=kinc Post-Initialization (Manifests and Readiness)
Documentation=https://github.com/T0MASD/kinc
After=kubeadm-init.service
Requires=kubeadm-init.service
ConditionPathExists=/var/lib/kubeadm-initialized
ConditionPathExists=!/var/lib/kinc-initialized
# Retry limits belong to the unit, not the service. Without these the default
# burst of 5 stops the retries above well before a slow API has come up.
#
# 20 starts per boot. This was StartLimitIntervalSec=0, which does not mean
# "no window" but "no limit": a failure that is not transient retried every
# 10 s for as long as the node ran (7,534 times, 2026-11-02 to -04). infinity
# makes the 20 a total, so a persistent fault ends as a failed unit someone
# can see instead of a loop nobody does.
StartLimitBurst=20
StartLimitIntervalSec=infinity

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
# The script waits a bounded time for node registration and then exits. With
# Restart=no, anything that delays the API means the CNI is never applied at
# all, which presents as CoreDNS stuck in ContainerCreating rather than as the
# bootstrap failure it is. Retrying is safe because each step checks before
# it writes: addons are created only when missing, objects that exist are left
# alone (tools/ci-verify-postinit-rerun.sh), and the success marker is written
# only on success, after which ConditionPathExists=! refuses to run.
Restart=on-failure
RestartSec=10

# Install manifests and wait for readiness
ExecStart=/etc/kinc/scripts/kinc-postinit.sh

# Create final success marker
ExecStartPost=/bin/touch /var/lib/kinc-initialized

# Log output to journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

