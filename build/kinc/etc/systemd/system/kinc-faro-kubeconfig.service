[Unit]
Description=kinc Faro kubeconfig staging
Documentation=https://github.com/T0MASD/kinc

# Every boot, not once.
#
# Faro runs as uid 65532 and kubeadm writes super-admin.conf 0600 root:root, so
# it reads a copy staged with its own ownership. That staging used to live in
# kinc-kubeadm-init.sh, which is correct on a first boot and wrong on every
# other one: kubeadm-init is gated on /var/lib/kubeadm-initialized, /var is a
# volume, and /etc/kinc is not. So on a cluster that comes back the marker
# still exists, the unit is skipped, and the file it would have written is gone
# with the old container - leaving a static pod pointing at a path that will
# never exist again.
#
# That bites wherever /etc/kubernetes is persistent and the cluster genuinely
# resumes. Where it is not, the node loses its PKI and manifests too and the
# kubeconfig is the least of it.
#
# The events directory has the same problem and the same shape. The kubelet
# creates it root-owned from DirectoryOrCreate, so kinc-preflight pre-creates it
# owned by 65532 - and kinc-preflight carries the same marker guard, so on a
# cluster first initialised before that code existed the directory is root-owned
# on a volume, preflight will never run again, and Faro dies on
#
#   failed to create log directory: mkdir /var/faro/events/logs: permission denied
#
# before it ever opens the kubeconfig. Fixing only the kubeconfig changes which
# error such a cluster gets, not whether Faro starts. install -d is idempotent,
# so this costs nothing where it is already right.
#
# No marker guard, so both run on a resume. Ordered after kubeadm-init for the
# first boot, where super-admin.conf does not exist until kubeadm has run;
# the condition below is what makes this a no-op rather than a failure then.
#
# Not ordered before kubelet, and it cannot be: on a first boot the chain is
# kubelet -> kinc-preflight -> kubeadm-init -> here, so Before=kubelet.service
# would be a cycle. On a resume the manifest is already in place, so the kubelet
# can start Faro before this has run. The kubelet retries with backoff and it
# heals, but a resumed cluster gets a weaker version of the guarantee a static
# pod exists for - capture from the first moment there is an API to capture.
After=kinc-preflight.service kubeadm-init.service
Wants=kubeadm-init.service
ConditionPathExists=/etc/kubernetes/super-admin.conf

[Service]
Type=oneshot
RemainAfterExit=yes

# Idempotent: install(1) overwrites, so re-staging an identical file is free
# and a stale one is corrected. 0600 because it is a credential, owned by the
# uid that has to read it.
ExecStart=/usr/bin/install -d -m 0755 -o 65532 -g 65532 /var/lib/kinc/faro-events
ExecStart=/usr/bin/install -D -m 0600 -o 65532 -g 65532 \
    /etc/kubernetes/super-admin.conf /etc/kinc/faro/kubeconfig

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
