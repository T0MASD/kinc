# kinc Consolidated Kubernetes Node
# Single-stage Dockerfile that combines base Fedora + CRI-O + kinc components
FROM fedora:44

# Set container metadata for systemd
ENV container=docker

# Cache-busting increment for package updates (increment when packages need updating)
ARG CACHE_BUST=1

# Install all dependencies using dnf (Fedora package manager)
# Packages are organized by category:
# - packages needed to run services (systemd)
# - packages needed for kubernetes components  
# - packages needed for networked backed storage with kubernetes
# - packages needed by the container runtime (CRI-O/crun)
# - misc packages kind uses itself
# - packages that provide semi-core kubernetes functionality
RUN echo "Installing Packages (cache bust: $CACHE_BUST)..." \
    && dnf update -y \
    # Everything from Fedora 44's released updates. cri-o1.37 was the last
    # holdout, pinned to updates-testing while it gathered karma as
    # FEDORA-2026-a91d5d8a66; it went stable on 2026-09-30 and the pin is gone.
    && dnf install -y \
      systemd \
      conntrack-tools nftables iptables-nft iproute ethtool util-linux kmod \
      libseccomp pigz fuse-overlayfs \
      nfs-utils iscsi-initiator-utils \
      bash ca-certificates curl jq yq procps-ng which hostname \
      cri-o1.37 crun \
      containernetworking-plugins \
      container-selinux \
      kubernetes1.37 \
      kubernetes1.37-kubeadm \
      cri-tools1.37 \
    && dnf clean all

# Configure systemd (separate layer for better caching)
RUN echo "Configuring systemd..." \
    && systemctl mask \
        dev-hugepages.mount \
        sys-fs-fuse-connections.mount \
        systemd-update-utmp.service \
        systemd-tmpfiles-setup.service \
        console-getty.service \
    && rm -f /lib/systemd/system/multi-user.target.wants/* \
    && rm -f /etc/systemd/system/*.wants/* \
    && rm -f /lib/systemd/system/local-fs.target.wants/* \
    && rm -f /lib/systemd/system/sockets.target.wants/*udev* \
    && rm -f /lib/systemd/system/sockets.target.wants/*initctl* \
    && rm -f /lib/systemd/system/basic.target.wants/* \
    && echo "ReadKMsg=no" >> /etc/systemd/journald.conf \
    && rm -f /sbin/init \
    && ln -s /usr/lib/systemd/systemd /sbin/init

# Enable/disable base services
RUN echo "Enabling / Disabling base services ... " \
    && systemctl enable kubelet.service \
    && systemctl enable crio.service \
    && systemctl enable dbus.socket \
    && systemctl enable dbus-broker.service \
    && systemctl mask systemd-binfmt.service

# Create required directories
RUN mkdir -p /etc/kubernetes/manifests \
    && mkdir -p /etc/systemd/system/multi-user.target.wants

# Copy in static files (adapted for Fedora/CRI-O)
# all scripts and directories are 0755 (rwx r-x r-x)
# all non-scripts are 0644 (rw- r-- r--)
# A digest of everything under base/ and kinc/, computed by tools/build.sh.
#
# The COPY layers below were served from cache after their sources changed, so
# a build reported success while shipping the previous run's scripts - a config
# placeholder went unsubstituted and the cluster failed on a fix that was
# already written. Recording the digest puts the content itself in the cache
# key, so any edit under those trees invalidates what follows, and the recorded
# value is what build.sh asserts the image against afterwards.
ARG KINC_CONTENT_DIGEST=unset
RUN mkdir -p /etc/kinc \
    && echo "$KINC_CONTENT_DIGEST" > /etc/kinc/.content-digest

COPY --chmod=0644 base/etc/* /etc/
COPY --chmod=0644 base/etc/containers/ /etc/containers/
COPY --chmod=0644 base/etc/crio/ /etc/crio/
COPY --chmod=0644 base/etc/default/* /etc/default/
COPY --chmod=0644 base/etc/sysctl.d/* /etc/sysctl.d/
COPY --chmod=0644 base/etc/systemd/system/* /etc/systemd/system/
COPY --chmod=0644 base/etc/systemd/system/kubelet.service.d/* /etc/systemd/system/kubelet.service.d/

# Copy CNI configuration (pre-install kindnet config to avoid bootstrap issues)

# Copy rootless crun wrapper for OOM score adjustment fix
COPY --chmod=0755 base/usr/local/bin/crun-wrapper.sh /usr/local/bin/crun-wrapper.sh

# Copy kinc-specific components
# New: Multi-service architecture for better observability
COPY kinc/etc/systemd/system/kinc-preflight.service /etc/systemd/system/kinc-preflight.service
COPY kinc/etc/systemd/system/kubeadm-init.service /etc/systemd/system/kubeadm-init.service
COPY kinc/etc/systemd/system/kinc-postinit.service /etc/systemd/system/kinc-postinit.service
COPY kinc/etc/systemd/system/kinc-cgroup-setup.service /etc/systemd/system/kinc-cgroup-setup.service
COPY --chmod=0755 kinc/etc/kinc/scripts/* /etc/kinc/scripts/
COPY kinc/kinc/manifests/ /kinc/manifests/

# Phase 2: Baked-in configuration with mounted config override
# Baked-in config at /etc/kinc/kubeadm.conf (used when no mount provided)
# Mounted config at /etc/kinc/config/kubeadm.conf (overrides baked-in if present)
RUN mkdir -p /etc/kinc/config
COPY --chmod=0644 kinc/etc/kinc/kubeadm.conf /etc/kinc/kubeadm.conf
# Asserted against kubeadm's actual phase list further down.
COPY --chmod=0644 kinc/etc/kinc/kubeadm-phases.expected /etc/kinc/kubeadm-phases.expected

# Faro bootstrap integration - static pod for earliest event capture
# Faro will start as soon as API server is available (before CNI)
# Controlled by KINC_ENABLE_FARO environment variable (deployed by kinc-preflight)
RUN mkdir -p /etc/faro /etc/kinc/faro
COPY --chmod=0644 kinc/etc/kubernetes/manifests/faro-bootstrap.yaml /etc/kinc/faro/faro-bootstrap.yaml
COPY --chmod=0644 kinc/etc/faro/config.yaml /etc/faro/config.yaml

# Copy rootless kubelet configuration
COPY --chmod=0644 base/var/lib/kubelet/config-rootless.yaml /var/lib/kubelet/config-rootless.yaml

# Copy runtime configuration files
# kubeadm.conf now mounted at runtime via Quadlet volume
COPY kinc/etc/kinc/patches/ /etc/kinc/patches/

# Setup crun wrapper for rootless OOM score adjustment fix
RUN echo "Setting up crun wrapper for rootless operation ..." \
    && mv /usr/bin/crun /usr/bin/crun.orig \
    && ln -sf /usr/local/bin/crun-wrapper.sh /usr/bin/crun \
    && echo "crun wrapper installed"

# Remove CRI-O's default bridge CNI config.
#
# Antrea is the cluster network, and its installer deletes this file when it
# writes 10-antrea.conflist. Until the agent gets that far, CRI-O picks the
# bridge as the only config present and tries to create pod networks with it,
# which cannot work here:
#
#   plugin type="bridge" failed (add): failed to enable keep_addr_on_down for
#   interface "eth0": open /proc/sys/net/ipv6/conf/eth0/keep_addr_on_down:
#   read-only file system
#
# Every pod scheduled in that window fails sandbox creation, retries, and
# succeeds once Antrea is ready - five errors across a bootstrap, describing a
# path that was never going to work rather than anything wrong.
#
# Without it there is no CNI config until Antrea writes one, so those pods wait
# in ContainerCreating instead, which is what is actually happening.
RUN rm -f /etc/cni/net.d/100-crio-bridge.conflist \
    && echo "removed CRI-O's default bridge CNI config; Antrea provides the only one"

# Enable kinc services now that service files are copied
# New: Multi-service architecture (preflight → kubeadm-init → postinit)
RUN echo "Enabling kinc services ..." \
    && systemctl enable kinc-preflight.service \
    && systemctl enable kubeadm-init.service \
    && systemctl enable kinc-postinit.service \
    && systemctl enable kinc-cgroup-setup.service \
    && echo "kinc services enabled (multi-service architecture)"

# Set proper permissions for kinc manifests
RUN chmod -R 755 /kinc/manifests/

# Verify installation and configuration
# The phase list kubeadm offers must match what kinc's phased init was written
# against.
#
# kinc runs kubeadm init as phases so the scheduler starts after its RBAC
# exists. That means kinc owns the ordering, and a phase added, removed or
# renamed by a Kubernetes release would otherwise pass silently: a removed phase
# fails the init loudly, but an ADDED one is worse - 'kubeadm init' would run it
# and kinc's script would not, producing a cluster missing a step with nothing
# to say so.
#
# Regenerate the expected list deliberately, as part of reading what the new
# phase does:
#   podman run --rm --entrypoint= <image> kubeadm init phase --help
RUN set -eu; \
    actual=$( { kubeadm init phase --help 2>&1 \
                  | awk '/Available Commands:/{f=1;next} /^$/{f=0} f && NF {print $1}'; \
                for p in certs kubeconfig etcd control-plane upload-config addon kubelet-finalize; do \
                  kubeadm init phase "$p" --help 2>&1 \
                    | awk -v P="$p" '/Available Commands:/{f=1;next} /^$/{f=0} f && NF {print P"/"$1}'; \
                done; } | sort ); \
    expected=$(grep -v '^#' /etc/kinc/kubeadm-phases.expected | sort); \
    if [ "$actual" != "$expected" ]; then \
        echo "kubeadm's phase list differs from what kinc-kubeadm-init.sh was written against:"; \
        diff <(echo "$expected") <(echo "$actual") || true; \
        echo "Read what changed, update kinc-kubeadm-init.sh if it matters, then"; \
        echo "regenerate build/kinc/etc/kinc/kubeadm-phases.expected."; \
        exit 1; \
    fi; \
    echo "✅ kubeadm phases match ($(echo "$expected" | wc -l) entries)"

RUN crio --version \
    && echo "CRI-O resolves the helpers named in its effective config:" \
    && pinns=$(crio config 2>/dev/null | sed -n 's/^[[:space:]]*pinns_path[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' | tail -1) \
    && { test -x "$pinns" || { \
         echo "pinns_path names '$pinns', which this image does not carry."; \
         echo "cri-o versions before 1.36.5 ship no pinns at all, so a cached"; \
         echo "package layer reaches here and fails. Rebuild the packages:"; \
         echo "  CACHE_BUST=\$(date +%s) ./tools/build.sh"; \
         exit 1; }; } \
    && echo "  pinns_path=$pinns" \
    && /usr/bin/crun.orig --version \
    && echo "crun wrapper installed:" \
    && ls -la /usr/bin/crun /usr/bin/crun.orig /usr/local/bin/crun-wrapper.sh \
    && crictl --version \
    && kubelet --version \
    && kubeadm version \
    && echo "CNI plugins installed via package:" \
    && ls -la /usr/libexec/cni/ \
    && echo "SystemD services enabled:" \
    && systemctl list-unit-files | grep enabled | grep -E "(crio|kubelet|kinc-preflight|kubeadm-init|kinc-postinit|kinc-cgroup-setup)" \
    && echo "Rootless configurations:" \
    && ls -la /etc/containers/storage.conf /etc/crio/crio.conf.d/04-rootless-storage.conf /etc/crio/crio.conf.d/05-rootless-cgroup.conf \
    && echo "✅ CRI-O container runtime configured with rootless support"

# systemd exits on SIGRTMIN+3, not SIGTERM (which re-executes it)
# https://bugzilla.redhat.com/show_bug.cgi?id=1201657
STOPSIGNAL SIGRTMIN+3

# Direct systemd entrypoint - no wrapper script needed
ENTRYPOINT [ "/sbin/init" ]

# Labels for metadata
LABEL io.kinc.version="v1.37.0-rootless"
LABEL io.kinc.runtime="crio"
LABEL io.kinc.init="baked-in"
LABEL io.kinc.rootless="true"
LABEL io.kinc.oom-wrapper="jq-based"